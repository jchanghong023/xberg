{
  "id": "chunking_rag_handoff",
  "category": "contract",
  "description": "Produces markdown-aware chunks that can be handed to a retrieval index",
  "docs": {
    "topic": "chunking",
    "title": "Prepare chunks for a RAG pipeline",
    "description": "Extract markdown-aware chunks and pass their content and metadata to your retrieval system.",
    "presentation": {
      "operations": [
        {
          "op": "show",
          "path": "results[0].chunks"
        }
      ]
    },
    "side_effects": "server"
  },
  "tags": [
    "chunking",
    "rag",
    "retrieval"
  ],
  "call": "extract",
  "input": {
    "mock_responses": [
      {
        "path": "/markdown/comprehensive.md",
        "status_code": 200,
        "headers": {
          "content-type": "application/octet-stream"
        },
        "body_file": "../test_documents/markdown/comprehensive.md"
      }
    ],
    "extract_input": {
      "kind": "uri",
      "uri": "$mock_url/markdown/comprehensive.md",
      "mime_type": "text/markdown"
    }
  },
  "assertions": [
    {
      "type": "not_error"
    },
    {
      "type": "count_min",
      "field": "results[0].chunks",
      "value": 2
    },
    {
      "type": "not_empty",
      "field": "results[0].chunks[0].content"
    },
    {
      "type": "not_empty",
      "field": "results[0].chunks[0].metadata"
    }
  ],
  "config": {
    "chunking": {
      "max_characters": 500,
      "overlap": 50,
      "trim": true,
      "chunker_type": "markdown"
    }
  }
}
