{
  "id": "pdf_hierarchy_config",
  "category": "contract",
  "description": "Extracts PDF heading hierarchy with bounding boxes",
  "docs": {
    "topic": "config",
    "title": "Configure PDF hierarchy extraction",
    "description": "Cluster PDF font sizes into heading levels and retain bounding boxes",
    "presentation": {
      "operations": [
        {
          "op": "show",
          "path": "results[0].pages"
        }
      ]
    },
    "side_effects": "server"
  },
  "tags": ["contract", "config", "pdf", "hierarchy"],
  "call": "extract",
  "input": {
    "mock_responses": [
      {
        "path": "/pdf/embedded_images_tables.pdf",
        "status_code": 200,
        "headers": {
          "content-type": "application/pdf"
        },
        "body_file": "../test_documents/pdf/embedded_images_tables.pdf"
      }
    ],
    "extract_input": {
      "kind": "uri",
      "uri": "$mock_url/pdf/embedded_images_tables.pdf",
      "mime_type": "application/pdf"
    }
  },
  "assertions": [
    {
      "type": "equals",
      "field": "results[0].mime_type",
      "value": "application/pdf"
    },
    {
      "type": "not_empty",
      "field": "results[0].pages"
    },
    {
      "type": "not_empty",
      "field": "results[0].pages[0].hierarchy.blocks"
    }
  ],
  "config": {
    "pdf_options": {
      "extract_metadata": true,
      "hierarchy": {
        "enabled": true,
        "k_clusters": 6,
        "include_bbox": true
      }
    }
  }
}
