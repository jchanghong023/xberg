{
  "id": "ocr_paddle_backend",
  "category": "contract",
  "description": "Selects PaddleOCR with the English mobile model",
  "docs": {
    "topic": "ocr",
    "title": "Use the PaddleOCR backend",
    "description": "Configure PaddleOCR language, model tier, and model version",
    "presentation": {
      "operations": [
        {
          "op": "show",
          "path": "results[0].content"
        }
      ]
    },
    "side_effects": "server"
  },
  "tags": ["contract", "ocr", "paddleocr"],
  "call": "extract",
  "input": {
    "mock_responses": [
      {
        "path": "/images/test_hello_world.png",
        "status_code": 200,
        "headers": {
          "content-type": "image/png"
        },
        "body_file": "../test_documents/images/test_hello_world.png"
      }
    ],
    "extract_input": {
      "kind": "uri",
      "uri": "$mock_url/images/test_hello_world.png",
      "mime_type": "image/png"
    }
  },
  "assertions": [
    {
      "type": "equals",
      "field": "results[0].mime_type",
      "value": "image/png"
    },
    {
      "type": "contains_all",
      "field": "results[0].content",
      "values": ["Hello", "World"]
    }
  ],
  "skip": {
    "languages": [
      "python",
      "rust",
      "node",
      "go",
      "ruby",
      "elixir",
      "wasm",
      "java",
      "csharp",
      "php",
      "dart",
      "kotlin_android",
      "swift",
      "zig"
    ],
    "reason": "Requires a PaddleOCR-enabled native build plus downloaded model weights; standard E2E jobs do not provision either, and browser WASM does not include PaddleOCR"
  },
  "config": {
    "ocr": {
      "enabled": true,
      "backend": "paddleocr",
      "language": ["en"],
      "paddle_ocr_settings": {
        "language": "en",
        "model_tier": "mobile",
        "model_version": "pp-ocrv6"
      }
    }
  }
}
