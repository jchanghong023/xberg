{
  "id": "chunking_config_and_output",
  "category": "contract",
  "description": "Extracts a local text document into bounded, overlapping chunks",
  "docs": {
    "topic": "chunking",
    "title": "Configure chunking and inspect the output",
    "description": "Set character limits and overlap, then read the chunks returned with the extraction result.",
    "presentation": {
      "operations": [
        {
          "op": "show",
          "path": "results[0].chunks"
        }
      ]
    },
    "side_effects": "server"
  },
  "tags": [
    "chunking",
    "contract",
    "retrieval"
  ],
  "call": "extract",
  "input": {
    "mock_responses": [
      {
        "path": "/text/book_war_and_peace_1p.txt",
        "status_code": 200,
        "headers": {
          "content-type": "application/octet-stream"
        },
        "body_file": "../test_documents/text/book_war_and_peace_1p.txt"
      }
    ],
    "extract_input": {
      "kind": "uri",
      "uri": "$mock_url/text/book_war_and_peace_1p.txt",
      "mime_type": "text/plain"
    }
  },
  "assertions": [
    {
      "type": "not_error"
    },
    {
      "type": "count_min",
      "field": "results[0].chunks",
      "value": 2
    },
    {
      "type": "min_length",
      "field": "results[0].chunks[0].content",
      "value": 9
    }
  ],
  "config": {
    "chunking": {
      "max_characters": 300,
      "overlap": 40,
      "trim": true,
      "chunker_type": "text"
    }
  }
}
