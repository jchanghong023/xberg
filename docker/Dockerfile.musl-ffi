# =============================================================================
# =============================================================================
FROM alpine:3.21 AS builder

ARG RUST_TOOLCHAIN=nightly-2026-03-10

WORKDIR /build

# Alpine's /bin/sh is busybox ash, which supports `-o pipefail`. Without it the
# `curl ... | sh` rustup bootstrap below reports only sh's status, so a failed or
# truncated download silently installs nothing, and the `ldd ... | awk | grep`
# vendoring pipeline reports success even when `ldd` itself fails -- which would
# ship the FFI library with an empty bundled closure (xberg #1280). (DL4006)
SHELL ["/bin/ash", "-o", "pipefail", "-c"]

RUN apk add --no-cache \
    curl musl-dev cmake make pkgconf bash patchelf \
    perl linux-headers git file && \
    apk add --no-cache \
        gcc g++ libstdc++ libstdc++-dev \
        onnxruntime-dev libheif-dev libde265-dev aom-dev x265-dev dav1d-dev \
    --repository=https://dl-cdn.alpinelinux.org/alpine/edge/community \
    --repository=https://dl-cdn.alpinelinux.org/alpine/edge/main

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain "${RUST_TOOLCHAIN}" --component rust-src && \
    echo "Rust host: $(~/.cargo/bin/rustc -vV | grep host)" && \
    echo "Default target: $(~/.cargo/bin/rustc --print cfg | grep target)"
ENV PATH="/root/.cargo/bin:${PATH}"

ENV ORT_LIB_LOCATION=/usr/lib
ENV ORT_PREFER_DYNAMIC_LINK=1
ENV ORT_SKIP_DOWNLOAD=1
ENV ORT_STRATEGY=system
ENV RUSTFLAGS="-C target-feature=-crt-static"

COPY Cargo.toml Cargo.lock ./
COPY crates/xberg/ crates/xberg/
COPY crates/xberg-gliner/ crates/xberg-gliner/
COPY crates/xberg-ffi/ crates/xberg-ffi/
COPY crates/xberg-tesseract/ crates/xberg-tesseract/
COPY crates/xberg-paddle-ocr/ crates/xberg-paddle-ocr/
COPY crates/xberg-candle-ocr/ crates/xberg-candle-ocr/
COPY crates/xberg-pdfium-render/ crates/xberg-pdfium-render/
COPY crates/xberg-native-pdf/ crates/xberg-native-pdf/
COPY crates/xberg-windows-metafile/ crates/xberg-windows-metafile/
COPY crates/xberg-libheif/ crates/xberg-libheif/
COPY crates/xberg-libwpd/ crates/xberg-libwpd/

RUN sed -i '/xberg-py/d; /xberg_rb/d; /xberg-node/d; /xberg-cli/d; /xberg-jni/d; /xberg-php/d; /xberg-rag/d; /xberg_rustler/d; /xberg_nif/d; /packages\/dart\/rust/d; /packages\/swift\/rust/d; /"crates\/xberg-wasm"/d; /^\[profile\.release\.package\.xberg-wasm\]$/,$d; /benchmark-harness/d; /e2e-generator/d; /e2e\/rust/d' Cargo.toml

RUN cargo build --release --package xberg-ffi && \
    cp target/release/libxberg_ffi.so /build/libxberg_ffi.so && \
    strip /build/libxberg_ffi.so

# Bundle the FULL transitive shared-lib closure (ONNX Runtime + image codecs,
# and everything THEY need in turn) that the runtime Alpine .NET/JDK base image
# does not provide, and point every bundled library's RUNPATH at its own
# directory so the musl loader resolves them beside libxberg_ffi.so. Without
# this the NuGet/Maven package ships the FFI library alone and the consumer
# raises DllNotFoundException / UnsatisfiedLinkError on an unresolved transitive
# dependency (xberg #1280, recurred for libonnxruntime's own libprotobuf-lite +
# ~40 libabsl_*/libre2/libicu* dependents that a hand-maintained allowlist of
# top-level libs can never keep in sync with). vendor-native-closure.sh walks
# `ldd` recursively instead of naming libraries by hand, and hard-fails the
# build (verify_local_closure) if anything is still unresolved after
# vendoring, so a missing transitive dependency breaks CI here instead of
# shipping silently. ~keep
COPY scripts/ci/vendor-native-closure.sh /usr/local/bin/vendor-native-closure.sh
RUN bash /usr/local/bin/vendor-native-closure.sh /build/libxberg_ffi.so

RUN file /build/libxberg_ffi.so && \
    echo "=== Dynamic dependencies ===" && \
    readelf -d /build/libxberg_ffi.so 2>/dev/null | grep NEEDED || echo "No dynamic dependencies (fully static)" && \
    echo "=== Bundled libraries ===" && \
    ls -la /build/*.so*

# `*.so*` (not `*.so`) is deliberate: Alpine's onnxruntime/libheif packages ship
# versioned sonames (libonnxruntime.so.1, libheif.so.1) that do not end in the
# literal ".so" suffix, so a plain `*.so` glob silently drops them from both the
# diagnostic listing above and this COPY — leaving the NuGet/Java native package
# with libxberg_ffi.so alone and no ORT (xberg #1280 recurrence). ~keep
FROM scratch
COPY --from=builder /build/*.so* /
